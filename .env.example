# ==============================================================================
# PHYSIO VOICE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your credentials.
# ==============================================================================

# 1. Supabase Cloud Project Configuration (PostgreSQL + RLS + Auth)
# Find in your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
# Server-only service role key (Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# 2. OpenAI API Configuration (Server-Side Voice Transcription & Clinical NLP)
# Used for Whisper transcription and GPT-4o structured extraction
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 3. Clinic Timezone Configuration (Standard for Indian Physiotherapy practices)
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata

# 4. Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. External Messaging Gateways (Optional: For verified WhatsApp / SMS delivery)
# Physio Voice enforces delivery truthfulness: external messages are marked PENDING_CONFIRMATION
# unless configured with active provider credentials.
# WhatsApp Cloud API (Meta):
WHATSAPP_API_TOKEN=your-whatsapp-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-here

# Transactional SMS Gateway (Fast2SMS / Twilio India):
SMS_API_KEY=your-sms-api-key-here
